APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Fuseau des horaires d'ouverture des établissements (Bénin : Africa/Porto-Novo)
APP_TIMEZONE=Africa/Porto-Novo
# URL du front web (liens « mot de passe oublié »)
FRONTEND_URL=http://localhost:5173
# Origines autorisées (CORS), séparées par des virgules — à restreindre en production
CORS_ALLOWED_ORIGINS=*

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SUPER_ADMIN_NAME=SuperAdmin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=password
SUPER_ADMIN_PHONE=

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_PHONE=

USER_EMAIL=user@example.com
USER_PASSWORD=password
USER_PHONE=

# Seeders (optional)
# Copy these into your backend/.env to override default credentials used by the seeders.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Realtime (Laravel Reverb - Pusher protocol)
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# En production : smtp (ou resend, postmark…) + MAIL_* ; « log » n'envoie aucun e-mail
# (les liens de réinitialisation de mot de passe ne partiraient pas).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Sign-In : client IDs OAuth (web, android, ios) acceptés comme audience, séparés par des virgules
GOOGLE_CLIENT_IDS=

# Notifications push (FCM HTTP v1) : contenu JSON du compte de service Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMS (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Délai d'appel par défaut si le service n'en définit pas (secondes)
CALL_TIMEOUT_SECONDS=600

# Processus lancés dans le conteneur de production (start.sh)
RUN_MIGRATIONS=true
RUN_QUEUE_WORKER=true
RUN_SCHEDULER=true

# Abonnements : durée de la période d'essai ouverte à la souscription en ligne (jours).
# L'abonnement passe en « actif » depuis le back-office super admin à réception du règlement.
SUBSCRIPTION_TRIAL_DAYS=30
