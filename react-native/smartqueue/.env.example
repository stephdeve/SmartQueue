# API Configuration
EXPO_PUBLIC_API_URL=https://smartqueue-production-40d4.up.railway.app/api/
EXPO_PUBLIC_WS_URL=wss://reverb-production-f6cb.up.railway.app
# Identifiants Reverb : doivent correspondre à REVERB_APP_KEY / REVERB_APP_ID du backend
EXPO_PUBLIC_REVERB_APP_KEY=your_reverb_app_key
EXPO_PUBLIC_REVERB_APP_ID=your_reverb_app_id

# Google Maps Configuration
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Environment
EXPO_PUBLIC_ENV=development

# App Configuration
EXPO_PUBLIC_APP_NAME=SmartQueue
EXPO_PUBLIC_APP_VERSION=1.0.0

# Firebase Configuration (optional - for push notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Debug Configuration
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug

# Contact et pages légales affichés dans l'app (Aide / À propos).
# Laissés vides, les entrées sont masquées. La politique de confidentialité est
# exigée par l'App Store et le Play Store (URL à renseigner aussi dans les fiches).
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
